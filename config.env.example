# Alma API Configuration
ALMA_API_KEY=your_alma_api_key_here
ALMA_API_URL=https://your-alma-domain.com/external_api/
ALMA_REALTY_API_URL=https://your-alma-domain.com/external_api/realty/

# Database Configuration
DB_HOST=localhost
DB_NAME=alma
DB_USER=alma_user
DB_PASS=your_database_password_here
DB_CHARSET=utf8mb4

# Project Configuration
PROJECT_DEFAULT_NAME=Dubai

# Application URLs (used by sync_contracts_batch.php when calling Api scripts over HTTP)
APP_BASE_URL=https://your-domain.com/alma/

# Dubai Project
PROJECT_DUBAI_ID=1
PROJECT_DUBAI_WEBHOOK_URL=https://your-dubai.bitrix24.eu/rest/1/xxx/
PROJECT_DUBAI_WEBHOOK_OUTGOING_URL=https://your-dubai.bitrix24.eu/rest/1/xxx/
PROJECT_DUBAI_NAME=Dubai
PROJECT_DUBAI_DOMAIN=your-dubai.bitrix24.eu

# Hong Kong Project
PROJECT_HONGKONG_ID=2
PROJECT_HONGKONG_WEBHOOK_URL=https://your-hk.bitrix24.com/rest/1/xxx/
PROJECT_HONGKONG_WEBHOOK_OUTGOING_URL=https://your-hk.bitrix24.com/rest/1/xxx/
PROJECT_HONGKONG_NAME=HongKong
PROJECT_HONGKONG_DOMAIN=your-hk.bitrix24.com

# Bitrix24 Events
BITRIX_EVENT_DEAL_ADD=ONCRMDEALADD
BITRIX_EVENT_DEAL_UPDATE=ONCRMDEALUPDATE
BITRIX_EVENT_DYNAMIC_UPDATE=ONCRMDYNAMICITEMUPDATE
BITRIX_EVENT_CONTACT_UPDATE=ONCRMCONTACTUPDATE

# Optional: set to 0 to disable SSL certificate verification (not recommended for production)
# VERIFY_SSL=1
